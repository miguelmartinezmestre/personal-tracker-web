{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "@playwright/test"],
        "incremental": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": [
        "playwright.config.ts",
        "src/tests-manual/playwright.manual.config.ts",
        "src/tests-manual/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": ["node_modules", "tests/.auth/**"]
}
