{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "@playwright/test"],
        "incremental": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": [
        "playwright.config.ts",
        "playwright.full.config.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tests/.auth/**"
    ]
}
