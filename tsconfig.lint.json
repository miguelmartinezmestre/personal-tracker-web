{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "types": ["node", "@testing-library/jest-dom"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "shared/**/*.ts",
        "scripts/**/*.ts",
        "convex/**/*.ts",
        "tests/**/*.ts",
        "proxy.ts",
        "next.config.ts"
    ],
    "exclude": ["node_modules", "convex/_generated", "convex/generated"]
}
