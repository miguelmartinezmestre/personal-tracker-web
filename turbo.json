{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_*", "BASE_URL", "FRONTEND_URL"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^check-types"],
            "cache": false
        },
        "test": {
            "dependsOn": ["^build"],
            "cache": false,
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**/*.ts",
                "src/**/*.tsx",
                "tests/**/*.ts",
                "tests/**/*.tsx",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/*.spec.tsx",
                "jest.config.*",
                "tsconfig.json"
            ],
            "outputs": ["coverage/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
