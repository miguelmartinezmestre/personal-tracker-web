# ============================================================
# Environment variables template
# ============================================================
#
# Legend:
#   [next]   → .env.local (dev) or the environment where you deploy nextjs app
#   [convex] → Convex Dashboard / `pnpm exec convex env set` / convex/.env
#   [docker] → Self-hosted stack only (docker compose / infrastructure)
#   [cli]    → Shell or .env.local for the Convex CLI (not Convex runtime)
# ============================================================

# ------------------------------------------------------------
# Primary deployment: Vercel + Convex Cloud
# ------------------------------------------------------------

# [next] Public frontend URLs (Next.js)
# NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app
# NEXT_PUBLIC_CONVEX_URL=https://<your-convex-deployment>.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-convex-deployment>.convex.site

# [convex] Backend auth and origins (Convex Cloud → Environment Variables)
# SITE_URL=https://<your-app>.vercel.app
# BETTER_AUTH_URL=https://<your-app>.vercel.app
# BETTER_AUTH_SECRET=<generated-secret>
# Required when SITE_URL is not localhost. Generate independently from BETTER_AUTH_SECRET and
# enter it in the first-run setup wizard. Minimum 32 characters.
# SETUP_SECRET=<generated-bootstrap-secret>
# Optional static JWKS. Omit unless you need static token verification.
# JWKS=<optional-static-jwks>

# [convex] Transactional email over SMTP (Convex Cloud → Environment Variables)
# EMAIL_FROM="Metricas <noreply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<smtp-password>

# ------------------------------------------------------------
# Local self-hosted development (Convex in Docker + Next.js)
# ------------------------------------------------------------
# `pnpm run convex:local` writes [next]/[cli] vars to .env.local and sets
# [convex] vars on the deployment (auth + MailDev). See self-host.md.

# [next] Frontend → self-hosted Convex
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_E2E_ALLOW_LOCAL_HTTP is runner-owned; never set it in a real production deployment.

# [cli] Without Docker, `pnpm run convex:local:no-docker` writes this instead of the two
# CONVEX_SELF_HOSTED_* variables below (the CLI refuses both at once):
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent

# [cli] Convex CLI targeting the self-hosted backend (do not add to Convex Cloud)
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=convex-self-hosted|<your-admin-key>

# [convex] Auth (must match the public app URL in NEXT_PUBLIC_SITE_URL)
# SITE_URL=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<generated-secret>
# SETUP_SECRET is optional only for a loopback SITE_URL.
# JWKS=<generated-jwks>

# [convex] MailDev (local; `pnpm run convex:local` sets these automatically). Without Docker,
# `convex:local:no-docker` uses SMTP_HOST=127.0.0.1 and MailDev runs with `pnpm mail:local`.
# EMAIL_FROM="Metricas <noreply@metricas.local>"
# SMTP_HOST=maildev
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=maildev
# SMTP_PASSWORD=maildev
# MailDev UI: http://127.0.0.1:1080  (e2e: http://127.0.0.1:1081)

# ------------------------------------------------------------
# Docker Compose infrastructure (self-hosted)
# ------------------------------------------------------------
# Convex/MySQL/MailDev service configuration. Not used by Next.js or Convex Cloud UI.
# Export in your shell or a private .env next to the compose file.

# [docker] MySQL
# MYSQL_ROOT_PASSWORD=<generated-mysql-root-password>
# DATABASE_URL=mysql://root:<generated-mysql-root-password>@mysql:3306/convex_self_hosted
# MYSQL_URL=mysql://root:<generated-mysql-root-password>@mysql:3306

# [docker] Self-hosted Convex instance
# INSTANCE_SECRET=<generated-convex-instance-secret>
# CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
# CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# [docker] Ports
# PORT=3210
# SITE_PROXY_PORT=3211
# DASHBOARD_PORT=6791
# MAILDEV_SMTP_PORT=1025
# MAILDEV_WEB_PORT=1080
# Local HTTP-only self-hosting uses 1. Production deployments must use TLS and set this to 0.
# DO_NOT_REQUIRE_SSL=1
