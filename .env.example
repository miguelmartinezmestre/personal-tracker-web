# # ============================================================
# # Environment Variables
# # ============================================================
# # Copy this file to .env.local, Vercel variables, Convex Cloud variables,
# # or a private .env file for Docker Compose. Replace every placeholder.

# # Main TFG deployment: Vercel + Convex Cloud
# NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app
# NEXT_PUBLIC_CONVEX_URL=https://<your-convex-deployment>.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-convex-deployment>.convex.site

# # Convex backend auth (configure in Convex Cloud env, or convex/.env locally)
# SITE_URL=https://<your-app>.vercel.app
# BETTER_AUTH_URL=https://<your-app>.vercel.app
# BETTER_AUTH_SECRET=<generated-secret>
# # Optional static JWKS. Omit it unless you explicitly need static token verification.
# JWKS=<optional-static-jwks>

# # Convex self-hosted database and instance
# MYSQL_ROOT_PASSWORD=<generated-mysql-root-password>
# MYSQL_DATABASE=convex_self_hosted
# DATABASE_URL=mysql://root:<generated-mysql-root-password>@mysql:3306/convex_self_hosted
# MYSQL_URL=mysql://root:<generated-mysql-root-password>@mysql:3306
# INSTANCE_NAME=metricas-tfg
# INSTANCE_SECRET=<generated-convex-instance-secret>

# # Convex self-hosted CLI (only needed for the Docker Compose alternative)
# CONVEX_SELF_HOSTED_URL=https://convex.example.com
# CONVEX_SELF_HOSTED_ADMIN_KEY=convex-self-hosted|<your-admin-key>

# # Frontend -> Convex self-hosted public URLs
# NEXT_PUBLIC_CONVEX_URL=https://convex.example.com
# NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-site.example.com
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# # Convex backend public origins
# CONVEX_CLOUD_ORIGIN=https://convex.example.com
# CONVEX_SITE_ORIGIN=https://convex-site.example.com

# # Docker Compose ports. The compose stack does not include Next.js, Caddy, or Nginx.
# PORT=3210
# SITE_PROXY_PORT=3211
# DASHBOARD_PORT=6791
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
# DO_NOT_REQUIRE_SSL=0

# # Transactional email provider
# # Use either:
# #   EMAIL_PROVIDER=resend with RESEND_API_KEY
# #   EMAIL_PROVIDER=smtp with SMTP_* values
# # The local self-hosted runner (`pnpm run convex:local`) configures
# # Convex to use MailHog automatically with the SMTP values below.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Metricas <noreply@example.com>"
# RESEND_API_KEY=<resend-api-key>

# # SMTP alternative. Required only when EMAIL_PROVIDER=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<smtp-password>

# # Local MailHog SMTP values used by `pnpm run convex:local` and e2e.
# # MailHog UI:
# #   local: http://127.0.0.1:8025
# #   e2e:   http://127.0.0.1:8026
# EMAIL_PROVIDER=smtp
# EMAIL_FROM="Metricas <noreply@metricas.local>"
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=mailhog
# SMTP_PASSWORD=mailhog

# # ============================================================
# # Development-only Variables (DO NOT enable in production)
# # ============================================================
# # Only enable for local/e2e test helpers. This is ignored in production builds.
# # Set to false or omit in production.
# ALLOW_SETUP_TEST=false
