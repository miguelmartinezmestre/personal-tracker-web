{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "proseWrap": "always",
    "overrides": [
        {
            "files": ["AGENTS.md", "CLAUDE.md"],
            "options": {
                "proseWrap": "preserve"
            }
        }
    ]
}
