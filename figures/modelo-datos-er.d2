  label: "organizationId"
  style: {
    stroke-dash: 4
  }
}

org_access.invitation -> auth_core.user: {
  label: "inviterId"
  style: {
    stroke-dash: 4
  }
}

goals_progress.objectives -> notif_audit.categories: {
  label: "category -> name"
  style: {
    stroke-dash: 2
  }
}

notif_audit.auditLogs -> resource_pointer: {
  label: "resourceType + resourceId"
  style: {
    stroke-dash: 2
  }
}

achievements_block.organizationAchievements -> auth_core.user: {
  label: "contributingUsers[]"
  style: {
    stroke-dash: 2
  }
}




