direction: right

legend: {
  shape: text
  label: |`md
| Modelo ER compacto (Convex) | |
| --- | --- |
| Omitidos | `_id`, `_creationTime`, timestamps y campos secundarios |
| Tipos | `string`, `number`, `boolean`, `id('tabla')`, `optional(...)` |
| Relaciones | sólida = referencia tipada; discontinua = lógica o externa |
`|
  style: { font-size: 10; font-color: "#111827" }
}

user: {
  shape: text
  label: |`md
| user | |
| --- | --- |
| name | string |
| email | string |
| role | optional(string \| null) |
| deletedAt | optional(number) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

session: {
  shape: text
  label: |`md
| session | |
| --- | --- |
| userId | string |
| activeOrganizationId | optional(string \| null) |
| expiresAt | number |
| impersonatedBy | optional(string \| null) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

account: {
  shape: text
  label: |`md
| account | |
| --- | --- |
| accountId | string |
| providerId | string |
| userId | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

verification: {
  shape: text
  label: |`md
| verification | |
| --- | --- |
| identifier | string |
| expiresAt | number |
`|
  style: { font-size: 10; font-color: "#111827" }
}

jwks: {
  shape: text
  label: |`md
| jwks | |
| --- | --- |
| publicKey | string |
| expiresAt | optional(number \| null) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

organization: {
  shape: text
  label: |`md
| organization | |
| --- | --- |
| name | string |
| slug | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

member: {
  shape: text
  label: |`md
| member | |
| --- | --- |
| organizationId | id('organization') |
| userId | id('user') |
| role | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

invitation: {
  shape: text
  label: |`md
| invitation | |
| --- | --- |
| organizationId | id('organization') |
| inviterId | id('user') |
| email | string |
| status | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

objectives: {
  shape: text
  label: |`md
| objectives | |
| --- | --- |
| organizationId | id('organization') |
| createdBy | id('user') |
| ownerId | id('user') |
| visibility | private \| organization |
| title | string |
| categoryId | optional(id('categories')) |
| completedAt | optional(number) |
| targetValue | number |
| currentValue | number |
| deadline | optional(number) |
| status | objectiveStatusValidator |
| workflowId | optional(vWorkflowId) |
| deletedAt | optional(number) |
| deletedBy | optional(id('user')) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

objectiveCollaborators: {
  shape: text
  label: |`md
| objectiveCollaborators | |
| --- | --- |
| objectiveId | id('objectives') |
| userId | id('user') |
| organizationId | id('organization') |
| role | editor \| viewer |
| addedBy | id('user') |
`|
  style: { font-size: 10; font-color: "#111827" }
}

progressUpdates: {
  shape: text
  label: |`md
| progressUpdates | |
| --- | --- |
| objective | id('objectives') |
| createdBy | id('user') |
| organizationId | id('organization') |
| updatedValue | number |
| updateDate | number |
| comment | optional(string) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

categories: {
  shape: text
  label: |`md
| categories | |
| --- | --- |
| userId | id('user') |
| organizationId | id('organization') |
| name | string |
| color | string |
| icon | optional(string) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

notifications: {
  shape: text
  label: |`md
| notifications | |
| --- | --- |
| userId | id('user') |
| organizationId | id('organization') |
| objective | optional(id('objectives')) |
| read | boolean |
| notificationType | notificationTypeValidator |
| notificationDate | number |
| message | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

notificationPreferences: {
  shape: text
  label: |`md
| notificationPreferences | |
| --- | --- |
| userId | id('user') |
| achievementNotifications | boolean |
| deadlineNotifications | boolean |
| progressNotifications | boolean |
| organizationNotifications | boolean |
`|
  style: { font-size: 10; font-color: "#111827" }
}

auditLogs: {
  shape: text
  label: |`md
| auditLogs | |
| --- | --- |
| userId | id('user') |
| actorUserId | optional(id('user')) |
| organizationId | id('organization') |
| action | string |
| resourceType | string |
| resourceId | optional(string) |
| severity | string |
`|
  style: { font-size: 10; font-color: "#111827" }
}

achievementDefinitions: {
  shape: text
  label: |`md
| achievementDefinitions | |
| --- | --- |
| code | string |
| type | achievementTypeValidator |
| category | achievementCategoryValidator |
| tier | achievementTierValidator |
| threshold | number |
| points | number |
| isActive | boolean |
`|
  style: { font-size: 10; font-color: "#111827" }
}

obtainedAchievements: {
  shape: text
  label: |`md
| obtainedAchievements | |
| --- | --- |
| userId | id('user') |
| achievement | id('achievementDefinitions') |
| earnedAt | number |
`|
  style: { font-size: 10; font-color: "#111827" }
}

organizationAchievements: {
  shape: text
  label: |`md
| organizationAchievements | |
| --- | --- |
| organization | id('organization') |
| achievement | id('achievementDefinitions') |
| earnedAt | number |
`|
  style: { font-size: 10; font-color: "#111827" }
}

organizationAchievementContributors: {
  shape: text
  label: |`md
| organizationAchievementContributors | |
| --- | --- |
| organizationAchievementId | id('organizationAchievements') |
| userId | id('user') |
| contributedAt | number |
| contributionValue | optional(number) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

platformSettings: {
  shape: text
  label: |`md
| platformSettings | |
| --- | --- |
| platformName | string |
| defaultLanguage | string |
| registrationPolicy | string |
| setupCompletedAt | optional(number) |
| setupCompletedBy | optional(id('user')) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

workflow: {
  shape: text
  label: |`md
| Convex Workflow | |
| --- | --- |
| workflowId | vWorkflowId |
`|
  style: { font-size: 10; font-color: "#111827" }
}

resourcePointer: {
  shape: text
  label: |`md
| Recurso polimórfico | |
| --- | --- |
| resourceType + resourceId | relación polimórfica |
`|
  style: { font-size: 10; font-color: "#111827" }
}

