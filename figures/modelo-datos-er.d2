direction: right

legend: {
  label: "Modelo de datos Convex\nCampos automaticos omitidos en todas las tablas: _id, _creationTime\nSolida = referencia fuerte con v.id(...)\nDiscontinua = relacion logica via string\nPunteada = relacion polimorfica o desnormalizada"
  style: {
    fill: "#FFFBEB"
    stroke: "#D97706"
    font-size: 16
    font-color: "#7C2D12"
  }
}

auth_core: {
  label: "Better Auth"
  direction: down
  style: {
    fill: "#EFF6FF"
    stroke: "#60A5FA"
    font-color: "#1D4ED8"
  }

  user: {
    shape: sql_table
    name: string
    email: string
    emailVerified: boolean
    role: string_optional
    banned: boolean_optional
    userId: external_string_optional
  }

  session: {
    shape: sql_table
    userId: string
    token: string
    expiresAt: number
    activeOrganizationId: string_optional
    impersonatedBy: string_optional
  }

  account: {
    shape: sql_table
    accountId: string
    providerId: string
    userId: string
    accessToken: string_optional
    password: string_optional
  }

  verification: {
    shape: sql_table
    identifier: string
    value: string
    expiresAt: number
    updatedAt: number
  }

  jwks: {
    shape: sql_table
    publicKey: string
    privateKey: string
    createdAt: number
    expiresAt: number_optional
  }
}

org_access: {
  label: "Organizaciones y acceso"
  direction: down
  style: {
    fill: "#ECFDF5"
    stroke: "#34D399"
    font-color: "#047857"
  }

  organization: {
    shape: sql_table
    name: string
    slug: string
    logo: string_optional
    metadata: string_optional
    createdAt: number
  }

  member: {
    shape: sql_table
    organizationId: string
    userId: string
    role: string
    createdAt: number
  }

  invitation: {
    shape: sql_table
    organizationId: string
    email: string
    role: string_optional
    status: string
    inviterId: string
    expiresAt: number
  }
}

goals_progress: {
  label: "Objetivos y progreso"
  direction: down
  style: {
    fill: "#FFF7ED"
    stroke: "#FB923C"
    font-color: "#C2410C"
  }

  objectives: {
    shape: sql_table
    organizationId: id_organization
    userId: id_user
    scope: enum_personal_organization
    title: string
    category: string_optional
    targetValue: number
    currentValue: number
    deadline: number_optional
    status: enum_active_completed
  }

  progressUpdates: {
    shape: sql_table
    objective: id_objectives
    updatedValue: number
    updateDate: number
    comment: string_optional
    updatedAt: number
  }
}

notif_audit: {
  label: "Notificaciones y auditoria"
  direction: down
  style: {
    fill: "#FEF2F2"
    stroke: "#F87171"
    font-color: "#B91C1C"
  }

  notifications: {
    shape: sql_table
    userId: id_user
    organizationId: id_organization
    objective: id_objectives_optional
    notificationType: enum_notification_type
    read: boolean
    notificationDate: number
  }

  auditLogs: {
    shape: sql_table
    userId: id_user
    organizationId: id_organization
    action: string
    resourceType: string
    resourceId: string_optional
    severity: string
    createdAt: number
  }

  categories: {
    shape: sql_table
    userId: id_user
    organizationId: id_organization
    name: string
    color: string
    "icon": string_optional
    updatedAt: number
  }
}

achievements_block: {
  label: "Logros"
  direction: down
  style: {
    fill: "#F0FDF4"
    stroke: "#86EFAC"
    font-color: "#166534"
  }

  achievementDefinitions: {
    shape: sql_table
    code: string
    type: enum_individual_organization
    category: enum_achievement_category
    tier: enum_achievement_tier
    threshold: number
    points: number
    isActive: boolean
  }

  obtainedAchievements: {
    shape: sql_table
    userId: id_user
    achievement: id_achievementDefinitions
    earnedAt: number
    updatedAt: number
  }

  organizationAchievements: {
    shape: sql_table
    organization: id_organization
    achievement: id_achievementDefinitions
    contributingUsers: id_user_array
    earnedAt: number
    updatedAt: number
  }
}

platform_block: {
  label: "Plataforma"
  direction: down
  style: {
    fill: "#F8FAFC"
    stroke: "#94A3B8"
    font-color: "#334155"
  }

  platformSettings: {
    shape: sql_table
    platformName: string
    defaultLanguage: string
    registrationPolicy: string
    setupCompletedAt: number_optional
    setupCompletedBy: id_user_optional
  }
}

resource_pointer: {
  label: "Polymorphic pointer\nresourceType + resourceId\ncan reference any resource"
  style: {
    fill: "#F8FAFC"
    stroke: "#94A3B8"
    font-color: "#475569"
  }
}

goals_progress.objectives -> auth_core.user: {
  label: "userId"
}

goals_progress.objectives -> org_access.organization: {
  label: "organizationId"
}

