  label: "userId"
}

notif_audit.auditLogs -> org_access.organization: {
  label: "organizationId"
}

notif_audit.categories -> auth_core.user: {
  label: "userId"
}

notif_audit.categories -> org_access.organization: {
  label: "organizationId"
}

achievements_block.obtainedAchievements -> auth_core.user: {
  label: "userId"
}

achievements_block.obtainedAchievements -> achievements_block.achievementDefinitions: {
  label: "achievement"
}

achievements_block.organizationAchievements -> org_access.organization: {
  label: "organization"
}

achievements_block.organizationAchievements -> achievements_block.achievementDefinitions: {
  label: "achievement"
}

platform_block.platformSettings -> auth_core.user: {
  label: "setupCompletedBy?"
}

auth_core.session -> auth_core.user: {
  label: "userId"
  style: {
    stroke-dash: 4
  }
}

auth_core.session -> org_access.organization: {
  label: "activeOrganizationId?"
  style: {
    stroke-dash: 4
  }
}

auth_core.session -> auth_core.user: {
  label: "impersonatedBy?"
  style: {
    stroke-dash: 4
  }
}

auth_core.account -> auth_core.user: {
  label: "userId"
  style: {
    stroke-dash: 4
  }
}

org_access.member -> org_access.organization: {
  label: "organizationId"
  style: {
    stroke-dash: 4
  }
}

org_access.member -> auth_core.user: {
  label: "userId"
  style: {
    stroke-dash: 4
  }
}

