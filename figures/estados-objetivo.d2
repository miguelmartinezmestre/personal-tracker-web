direction: down

legend: {
  shape: text
  label: |`md
| Estados de un objetivo (Convex) | |
| --- | --- |
| Estados persistidos | `active`, `completed` (campo `status`) |
| Pseudo-estados | inicio y decisión no se almacenan |
| Borrado | lógico (`deletedAt`/`deletedBy`, reversible con restore) y físico (purge: cascada) |
| Transición automática | `active` <-> `completed` según `currentValue >= targetValue` (al crear/borrar progreso o editar) |
| Deadline | NO transiciona: solo genera notificaciones (cron 8:00) |
`|
  style: { font-size: 10; font-color: "#111827" }
}

inicio: "" {
  shape: circle
  width: 28
  height: 28
  style: { fill: "#111827"; stroke: "#111827" }
}

crear: "startValue == targetValue?" {
  shape: diamond
  style: { font-size: 10; fill: "#fef3c7"; stroke: "#d97706" }
}

active: {
  shape: text
  label: |`md
| **active** | |
| --- | --- |
| status | `active` |
| condición | `currentValue < targetValue` |
| completedAt | sin fijar |
`|
  style: { font-size: 10; font-color: "#111827"; fill: "#dbeafe"; stroke: "#2563eb"; border-radius: 8 }
}

completed: {
  shape: text
  label: |`md
| **completed** | |
| --- | --- |
| status | `completed` |
| condición | `currentValue >= targetValue` |
| completedAt | fijado (= now) |
`|
  style: { font-size: 10; font-color: "#111827"; fill: "#dcfce7"; stroke: "#16a34a"; border-radius: 8 }
}

soft_deleted: {
  shape: text
  label: |`md
| **soft_deleted** (borrado lógico) | |
| --- | --- |
| deletedAt / deletedBy | fijados |
| visibilidad | oculto en consultas |
| reversible | `restoreObjective` |
`|
  style: { font-size: 10; font-color: "#111827"; fill: "#fef9c3"; stroke: "#ca8a04"; border-radius: 8 }
}

restaurar: "currentValue >= targetValue?" {
  shape: diamond
  style: { font-size: 10; fill: "#fef3c7"; stroke: "#d97706" }
}

eliminado: "Eliminado (purge)\n(cascada: progressUpdates + objectiveCollaborators + notifications)" {
  shape: circle
  style: { font-size: 10; fill: "#fee2e2"; stroke: "#dc2626"; double-border: true }
}

deadline: {
  shape: text
  label: |`md
| _Efecto lateral_ | |
| --- | --- |
| cron 8AM | `runDeadlineNotificationsCron` |
| acción | notificación "deadline" |
| estado | **no cambia** |
`|
  style: { font-size: 10; font-color: "#6b7280"; stroke-dash: 3 }
}

inicio -> crear: "createObjective"
crear -> active: "startValue < targetValue"
crear -> completed: "startValue == targetValue"

active -> active: "progreso (meta no alcanzada)"
active -> completed: "alcanza la meta (o updateObjective)"
completed -> active: "borra progreso (o updateObjective)"

active -> soft_deleted: "deleteObjective (borrado lógico)"
completed -> soft_deleted: "deleteObjective (borrado lógico)"
soft_deleted -> restaurar: "restoreObjective (recalcula)"
restaurar -> active: "< target"
restaurar -> completed: ">= target"
soft_deleted -> eliminado: "purgeObjective"

active -> deadline: "deadline próximo" {
  style: { stroke-dash: 3; stroke: "#6b7280" }
}
