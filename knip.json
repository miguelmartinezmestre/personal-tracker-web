{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/app/**/*.{ts,tsx}",
        "convex/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "tests/**/*.ts"
    ],
    "project": ["src/**/*.{ts,tsx}", "convex/**/*.ts", "scripts/**/*.{ts,mjs,js}", "tests/**/*.ts"],
    "ignoreBinaries": ["d2"],
    "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
    "ignoreExportsUsedInFile": true
}
