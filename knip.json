{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/app/**/*.{ts,tsx}",
        "convex/**/*.ts",
        "scripts/*.{ts,mjs,js}",
        "tests/**/*.{spec,test}.ts",
        "tests/setup/auth.stack.setup.ts"
    ],
    "project": [
        "src/**/*.{ts,tsx,css}",
        "convex/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "tests/**/*.ts",
        "shared/**/*.ts"
    ],
    "playwright": {
        "config": ["playwright.config.ts", "tests/manual/playwright.manual.config.ts"]
    },
    "ignoreBinaries": ["d2"],
    "ignoreExportsUsedInFile": true,
    "includeEntryExports": true
}
