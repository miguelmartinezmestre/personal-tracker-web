{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "next.config.ts",
        "proxy.ts",
        "src/app/**/*.{ts,tsx}",
        "convex/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "vitest.config.ts"
    ],
    "project": ["src/**/*.{ts,tsx}", "convex/**/*.ts", "scripts/**/*.{ts,mjs,js}"],
    "ignore": [
        "**/node_modules/**",
        "**/.next/**",
        "**/.next-e2e/**",
        "**/dist/**",
        "**/coverage/**",
        "**/build/**",
        "**/*.d.ts",
        "**/_generated/**",
        "**/test-results/**",
        "**/playwright-report/**",
        "tests/**",
        "convex/tests/**",
        "src/components/ui/**",
        "src/tests-manual/**",
        "mysql-data/**",
        "data/**"
    ],
    "ignoreDependencies": [
        "rimraf",
        "postcss",
        "postcss-load-config",
        "jsdom",
        "vite"
    ],
    "ignoreExportsUsedInFile": true
}
