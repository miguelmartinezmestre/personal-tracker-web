{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/app/**/*.{ts,tsx}",
        "convex/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "tests/**/*.ts"
    ],
    "project": [
        "src/**/*.{ts,tsx,css}",
        "convex/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "tests/**/*.ts"
    ],
    "ignoreBinaries": ["d2"],
    "ignoreExportsUsedInFile": true
}
