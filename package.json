{
  "name": "repotestttttt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && npx rimraf node_modules || true",
    "gen:typescript-package": "turbo gen typescript-package",
    "gen": "turbo gen",
    "generate-admin-key": "docker compose exec backend ./generate_admin_key.sh",
    "test-vitest": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "turbo": "^2.6.3",
    "typescript": "5.9.3",
    "dotenv": "17.2.3",
    "jose": "6.1.0"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "pnpm@10.11.0"
}