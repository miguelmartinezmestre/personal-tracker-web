{
  "name": "metricas-tfg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"pnpm dev:front\"",
    "dev:front": "next dev",
    "dev:convex": "convex dev",
    "convex:codegen": "convex codegen",
    "build": "next build",
    "start": "next start",
    "checks": "pnpm run format:check && pnpm run check-types && pnpm run lint && pnpm run test && pnpm run knip && pnpm run check-translations",
    "checks:e2e": "pnpm run checks && pnpm run test:e2e",
    "convex:local": "tsx scripts/run-convex-stack.ts",
    "better-auth:generate": "npx @better-auth/cli generate -y --output convex/authSchema.ts --config convex/auth.ts",
    "lint": "eslint . --max-warnings=0",
    "check-types": "pnpm run check-types:app && pnpm run check-types:tests && pnpm run check-types:playwright",
    "check-types:app": "tsc --noEmit",
    "check-types:tests": "tsc --noEmit -p convex/tsconfig.json",
    "check-types:playwright": "tsc --noEmit -p tsconfig.playwright.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/run-e2e-stack.ts",
    "test:e2e:tfg": "tsx scripts/run-e2e-stack.ts --config=tests/manual/playwright.manual.config.ts tests/manual/tfg-walkthrough.spec.ts",
    "check-translations": "tsx scripts/check-translations.ts",
    "generate-admin-key": "cd infrastructure && docker compose exec backend ./generate_admin_key.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "fix": "pnpm run format",
    "knip": "knip",
    "prepare": "husky",
    "generate-jwks": "npx convex run generated/auth:getLatestJwks | npx convex env set JWKS",
    "install": "node scripts/install-playwright-browsers.mjs",
    "playwright:install": "pnpm exec playwright install",
    "doctor": "npx react-doctor@latest --verbose --full"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/resend": "^0.2.4",
    "@convex-dev/workflow": "0.4.2",
    "@convex-dev/workpool": "^0.4.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "1.39.1",
    "convex-helpers": "^0.1.118",
    "convex-test": "^0.0.53",
    "date-fns": "^4.2.1",
    "hono": "^4.12.21",
    "js-cookie": "3.0.7",
    "kitcn": "^0.14.3",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "nodemailer": "^8.0.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "1.4.0",
    "ua-parser-js": "2.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "overrides": {
      "glob": "^11.1.0",
      "js-yaml": "^4.1.1",
      "tmp": ">=0.2.4"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
