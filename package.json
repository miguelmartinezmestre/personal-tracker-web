{
    "name": "my-fullstack-app",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "clean": "find . -type d -name \"node_modules\" -prune -exec rm -rf {} +",
        "prepare": "husky",
        "knip": "knip"
    },
    "devDependencies": {
        "@types/node": "^22.13.13",
        "eslint": "^9.19.0",
        "husky": "^9.1.7",
        "knip": "^5.46.2",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.2",
        "turbo": "^2.4.2",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "packageManager": "pnpm@10.4.1",
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "**/*.{js,ts,tsx,jsx,json,md,html,css,scss}": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "axios": "^1.7.9"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@nestjs/core",
            "@prisma/client",
            "@prisma/engines",
            "@scarf/scarf",
            "@swc/core",
            "bcrypt",
            "core-js-pure",
            "esbuild",
            "prisma",
            "sharp"
        ]
    }
}
