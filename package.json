{
  "name": "metricas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=stream",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --ui=stream",
    "test": "turbo run test --ui=stream",
    "test:playwright": "pnpm -C apps/front test",
    "test:playwright:coverage": "pnpm -C apps/front test:coverage",
    "test:convex": "vitest run packages/backend/convex",
    "test:react": "vitest run apps/front/src/features",
    "test:convex:coverage": "vitest run --coverage packages/backend/convex",
    "test:react:coverage": "vitest run --coverage apps/front/src/features",
    "test:all": "pnpm run test:convex & pnpm run test:react & pnpm run test:playwright",
    "test:all:coverage": "vitest run --coverage packages/backend/convex apps/front/src/features; pnpm run test:playwright:coverage",
    "clean": "turbo run clean && node scripts/clean.mjs node_modules .next .turbo",
    "gen:typescript-package": "turbo gen typescript-package",
    "gen": "turbo gen",
    "generate-admin-key": "docker compose exec backend ./generate_admin_key.sh",
    "create-user": "tsx scripts/create-user.ts",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "dotenv": "17.2.3",
    "jose": "6.1.0",
    "knip": "^5.79.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "glob": "^11.1.0",
      "js-yaml": "^4.1.1",
      "tmp": ">=0.2.4",
      "rimraf": "^6.1.2"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}