{
    "name": "metricas-tfg",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "convex dev --start \"pnpm dev:front\"",
        "dev:front": "next dev",
        "dev:convex": "convex dev",
        "build": "next build",
        "start": "next start",
        "better-auth:generate": "npx @better-auth/cli generate -y --output convex/authSchema.ts --config convex/auth.ts",
        "lint": "eslint .",
        "check-types": "pnpm run check-types:app && pnpm run check-types:tests && pnpm run check-types:playwright",
        "check-types:app": "tsc --noEmit",
        "check-types:tests": "tsc --noEmit -p convex/tsconfig.json",
        "check-types:playwright": "tsc --noEmit -p tsconfig.playwright.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsx scripts/run-e2e-stack.ts",
        "test:e2e:tfg": "tsx scripts/run-e2e-stack.ts --config=src/tests-manual/playwright.manual.config.ts src/tests-manual/tfg-walkthrough.spec.ts",
        "check-translations": "node scripts/check-translations.js",
        "create-user": "tsx scripts/create-user.ts",
        "generate-admin-key": "cd infrastructure && docker compose -f docker-compose.dev.yml exec backend ./generate_admin_key.sh",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "knip": "knip",
        "prepare": "husky",
        "generate-jwks": "npx convex run generated/auth:getLatestJwks | npx convex env set JWKS",
        "install": "pnpm exec playwright install"
    },
    "dependencies": {
        "@convex-dev/react-query": "^0.1.0",
        "@convex-dev/resend": "^0.2.3",
        "@convex-dev/workflow": "0.3.12",
        "@convex-dev/workpool": "^0.4.6",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-aspect-ratio": "^1.1.8",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-menubar": "^1.1.16",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toggle": "^1.1.10",
        "@radix-ui/react-toggle-group": "^1.1.11",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-form": "1.29.1",
        "@tanstack/react-query": "5.100.9",
        "@tanstack/react-table": "8.21.3",
        "better-auth": "1.6.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "1.37.0",
        "convex-helpers": "^0.1.116",
        "convex-test": "^0.0.51",
        "date-fns": "^4.1.0",
        "hono": "^4.12.18",
        "js-cookie": "3.0.5",
        "kitcn": "^0.14.3",
        "lucide-react": "1.14.0",
        "next": "16.2.6",
        "next-intl": "4.11.0",
        "next-themes": "0.4.6",
        "nodemailer": "^8.0.7",
        "react": "19.2.6",
        "react-day-picker": "^9.14.0",
        "react-dom": "19.2.6",
        "recharts": "3.8.1",
        "server-only": "^0.0.1",
        "sonner": "2.0.7",
        "tailwind-merge": "^3.5.0",
        "tsx": "^4.21.0",
        "tw-animate-css": "1.4.0",
        "ua-parser-js": "2.0.9",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@convex-dev/eslint-plugin": "^2.0.0",
