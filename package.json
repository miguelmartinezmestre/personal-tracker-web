{
    "name": "metricas-tfg",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "convex dev --start \"pnpm dev:front\"",
        "dev:front": "next dev",
        "dev:convex": "convex dev",
        "checks": "pnpm checks:static && pnpm test",
        "checks:static": "pnpm format:check && pnpm check-types && pnpm lint && pnpm knip && pnpm check-translations && pnpm check-peers",
        "checks:e2e": "pnpm checks && pnpm test:e2e",
        "ci": "pnpm checks:static && pnpm test:coverage && pnpm build && pnpm test:e2e",
        "convex:local": "tsx scripts/run-convex-stack.ts",
        "convex:local:stop": "tsx scripts/run-convex-stack.ts --stop",
        "convex:local:reset": "tsx scripts/run-convex-stack.ts --reset --confirm",
        "convex:local:no-docker": "tsx scripts/run-convex-stack.ts --no-docker",
        "convex:local:no-docker:reset": "tsx scripts/run-convex-stack.ts --no-docker --reset --confirm",
        "mail:local": "maildev --ip 127.0.0.1 --web-ip 127.0.0.1 --incoming-user maildev --incoming-pass maildev",
        "better-auth:generate": "pnpm exec auth generate -y --output convex/features/auth/authSchema.ts --config convex/auth.ts",
        "lint": "oxlint --deny-warnings --tsconfig tsconfig.lint.json && eslint convex --max-warnings=0",
        "lint:convex": "eslint convex --max-warnings=0",
        "lint:fix": "oxlint --fix --deny-warnings && eslint convex --fix --max-warnings=0",
        "check-types": "pnpm check-types:frontend-tests && pnpm check-types:app && pnpm check-types:tests && pnpm check-types:playwright && pnpm check-types:scripts && pnpm check-types:tools",
        "format": "prettier . --write --ignore-unknown",
        "test": "pnpm test:backend && pnpm test:frontend",
        "test:e2e": "tsx scripts/run-e2e-stack.ts",
        "test:e2e:no-docker": "tsx scripts/run-e2e-stack.ts --no-docker",
        "build": "next build",
        "start": "next start",
        "check-types:app": "tsc --noEmit",
        "check-types:tests": "tsc --noEmit -p convex/tsconfig.json",
        "check-types:playwright": "tsc --noEmit -p tsconfig.playwright.json",
        "check-types:frontend-tests": "tsc --noEmit -p tsconfig.frontend-tests.json",
        "check-types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
        "check-types:tools": "tsc --noEmit -p tools/tsconfig.json",
        "test:coverage": "vitest run --coverage && vitest run --config vitest.frontend.config.ts --coverage",
        "check-translations": "tsx scripts/check-translations.ts",
        "check-peers": "pnpm peers check",
        "format:check": "prettier . --check --ignore-unknown",
        "generate-jwks": "tsx scripts/generate-jwks.ts",
        "playwright:install": "pnpm exec playwright install chromium firefox webkit",
        "playwright:install:ci": "pnpm exec playwright install --with-deps chromium firefox webkit",
        "doctor": "react-doctor --verbose --full",
        "test:backend": "vitest run",
        "test:frontend": "vitest run --config vitest.frontend.config.ts",
        "generate:db-diagram": "d2 --layout=dagre --pad=20 --dagre-nodesep=30 --dagre-edgesep=10 figures/modelo-datos-er.d2 figures/modelo-datos-er-pdf.png",
        "generate:states-diagram": "d2 --layout=elk --pad=20 figures/estados-objetivo.d2 figures/estados-objetivo.png",
        "convex:codegen": "convex codegen",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@convex-dev/aggregate": "0.3.1",
        "@convex-dev/react-query": "^0.1.0",
        "@tanstack/charts": "1.0.0",
        "@tanstack/react-form": "1.33.3",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-table": "9.1.0",
        "better-auth": "1.7.10",
        "chrono-node": "2.10.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "1.46.0",
        "convex-helpers": "0.1.120",
        "hono": "4.13.11",
        "js-cookie": "3.0.8",
        "kitcn": "0.33.11",
        "lucide-react": "1.30.0",
        "next": "16.4.2",
        "next-intl": "4.13.5",
        "next-themes": "0.4.6",
        "nodemailer": "10.1.4",
        "react": "19.2.8",
        "react-day-picker": "10.0.2",
        "react-dom": "19.2.8",
        "server-only": "^0.0.1",
        "sonner": "2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@convex-dev/eslint-plugin": "^2.0.0",
        "@edge-runtime/vm": "^5.0.0",
        "@oxlint/plugins": "1.77.0",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.6",
        "@types/js-cookie": "3.0.6",
        "@types/node": "~24.13.3",
        "@types/nodemailer": "8.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitest/coverage-v8": "4.1.12",
        "auth": "1.7.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "convex-test": "0.0.55",
        "eslint": "^10.8.1",
        "execa": "^10.0.1",
        "get-port": "^7.2.0",
        "husky": "^9.1.7",
        "jsdom": "30.0.1",
        "knip": "^6.31.0",
        "maildev": "3.0.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "react-doctor": "^0.2.1",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.1",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "4.1.12"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "packageManager": "pnpm@12.9.1"
}
