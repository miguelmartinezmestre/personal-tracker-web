{
    "name": "metricas-tfg",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "convex dev --start \"pnpm dev:front\"",
        "dev:front": "next dev",
        "dev:convex": "convex dev",
        "convex:codegen": "convex codegen",
        "build": "next build",
        "start": "next start",
        "checks": "tsx scripts/quality.ts checks",
        "checks:e2e": "tsx scripts/quality.ts checks-e2e",
        "ci": "tsx scripts/quality.ts ci",
        "ci:quick": "tsx scripts/quality.ts checks",
        "convex:local": "tsx scripts/run-convex-stack.ts",
        "better-auth:generate": "pnpm exec auth generate -y --output convex/authSchema.ts --config convex/auth.ts",
        "lint": "node scripts/run-lint.mjs",
        "lint:convex": "eslint convex --max-warnings=0",
        "lint:fix": "oxlint --fix --deny-warnings && eslint convex --fix --max-warnings=0",
        "check-types": "tsx scripts/quality.ts types",
        "check-types:app": "tsc --noEmit",
        "check-types:tests": "tsc --noEmit -p convex/tsconfig.json",
        "check-types:playwright": "tsc --noEmit -p tsconfig.playwright.json",
        "test": "tsx scripts/quality.ts test",
        "test:coverage": "tsx scripts/quality.ts coverage",
        "test:e2e": "tsx scripts/run-e2e-stack.ts",
        "test:e2e:tfg": "tsx scripts/run-e2e-stack.ts --config=tests/manual/playwright.manual.config.ts tests/manual/tfg-walkthrough.spec.ts",
        "check-translations": "tsx scripts/check-translations.ts",
        "check-convex-contracts": "tsx scripts/check-convex-contracts.ts",
        "check-peers": "pnpm peers check",
        "deps:outdated": "pnpm outdated",
        "deps:audit": "pnpm audit --prod --audit-level high",
        "deps:sbom": "tsx scripts/generate-sbom.ts",
        "generate-admin-key": "cd infrastructure && docker compose exec backend ./generate_admin_key.sh",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "fix": "pnpm run lint:fix && pnpm run format",
        "knip": "knip",
        "prepare": "husky",
        "generate-jwks": "tsx scripts/generate-jwks.ts",
        "generate:db-diagram": "d2 --layout=dagre --pad=20 --dagre-nodesep=30 --dagre-edgesep=10 figures/modelo-datos-er.d2 figures/modelo-datos-er-pdf.png",
        "generate:states-diagram": "d2 --layout=elk --pad=20 figures/estados-objetivo.d2 figures/estados-objetivo.png",
        "playwright:install": "pnpm exec playwright install",
        "playwright:install:ci": "pnpm exec playwright install --with-deps chromium firefox webkit",
        "doctor": "react-doctor --verbose --full",
        "deps:licenses": "tsx scripts/generate-licenses.ts",
        "convex:local:reset": "tsx scripts/run-convex-stack.ts --reset --confirm",
        "test:backend": "vitest run",
        "test:frontend": "vitest run --config vitest.frontend.config.ts",
        "check-types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
        "convex:local:stop": "tsx scripts/run-convex-stack.ts --stop",
        "check-requirements": "tsx scripts/check-requirements.ts",
        "verify:backend": "tsx scripts/verification-backend.ts",
        "verify:backend:http": "tsx scripts/verify-local-backend.ts",
        "verify:generated": "tsx scripts/check-generated.ts",
        "evidence": "tsx scripts/generate-evidence.ts"
    },
    "dependencies": {
        "@convex-dev/aggregate": "0.2.2",
        "@convex-dev/react-query": "^0.1.0",
        "@convex-dev/resend": "0.2.6",
        "@radix-ui/react-alert-dialog": "1.1.23",
        "@radix-ui/react-dialog": "1.1.23",
        "@radix-ui/react-dropdown-menu": "2.1.24",
        "@radix-ui/react-label": "2.1.15",
        "@radix-ui/react-popover": "1.1.23",
        "@radix-ui/react-progress": "1.1.16",
        "@radix-ui/react-radio-group": "1.4.7",
        "@radix-ui/react-select": "2.3.7",
        "@radix-ui/react-slot": "1.3.3",
        "@radix-ui/react-switch": "1.3.7",
        "@radix-ui/react-tabs": "1.1.21",
        "@radix-ui/react-tooltip": "1.2.16",
        "@tanstack/react-form": "1.33.3",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-table": "9.1.0",
        "better-auth": "1.6.23",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "1.43.0",
        "convex-helpers": "0.1.120",
        "hono": "4.13.1",
        "js-cookie": "3.0.8",
        "kitcn": "^0.15.14",
        "lucide-react": "1.30.0",
        "next": "16.3.0",
        "next-intl": "4.13.5",
        "next-themes": "0.4.6",
        "nodemailer": "9.0.5",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "recharts": "3.10.1",
        "server-only": "^0.0.1",
        "sonner": "2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "1.4.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@convex-dev/eslint-plugin": "^2.0.0",
        "@edge-runtime/vm": "^5.0.0",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.6",
        "@types/js-cookie": "3.0.6",
        "@types/node": "~24.13.3",
        "@types/nodemailer": "8.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitest/coverage-v8": "^4.1.10",
        "auth": "1.6.23",
        "babel-plugin-react-compiler": "^1.0.0",
        "convex-test": "0.0.55",
        "eslint": "^10.8.1",
        "husky": "^9.1.7",
        "jsdom": "30.0.1",
        "knip": "^6.31.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "react-doctor": "^0.2.1",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.1",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "packageManager": "pnpm@12.3.4"
}
