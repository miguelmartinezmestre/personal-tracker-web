{
    "name": "metricas-tfg",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "convex dev --start \"pnpm dev:front\"",
        "dev:front": "next dev",
        "dev:convex": "convex dev",
        "convex:codegen": "convex codegen",
        "build": "next build",
        "start": "next start",
        "checks": "pnpm run format:check && pnpm run check-types && pnpm run lint && pnpm run test && pnpm run knip && pnpm run check-translations && pnpm run check-convex-contracts && pnpm run check-peers",
        "checks:e2e": "pnpm run checks && pnpm run test:e2e",
        "ci": "pnpm run checks && pnpm run build && pnpm run test:e2e",
        "ci:quick": "pnpm run checks",
        "convex:local": "tsx scripts/run-convex-stack.ts",
        "better-auth:generate": "pnpm exec auth generate -y --output convex/authSchema.ts --config convex/auth.ts",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "check-types": "pnpm run check-types:app && pnpm run check-types:tests && pnpm run check-types:playwright",
        "check-types:app": "tsc --noEmit",
        "check-types:tests": "tsc --noEmit -p convex/tsconfig.json",
        "check-types:playwright": "tsc --noEmit -p tsconfig.playwright.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsx scripts/run-e2e-stack.ts",
        "test:e2e:tfg": "tsx scripts/run-e2e-stack.ts --config=tests/manual/playwright.manual.config.ts tests/manual/tfg-walkthrough.spec.ts",
        "check-translations": "tsx scripts/check-translations.ts",
        "check-convex-contracts": "tsx scripts/check-convex-contracts.ts",
        "check-peers": "pnpm peers check",
        "deps:outdated": "pnpm outdated",
        "deps:audit": "pnpm audit --prod --audit-level high",
        "deps:sbom": "pnpm licenses list --json",
        "generate-admin-key": "cd infrastructure && docker compose exec backend ./generate_admin_key.sh",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "fix": "pnpm run lint:fix && pnpm run format",
        "knip": "knip",
        "prepare": "husky",
        "generate-jwks": "pnpm exec convex run generated/auth:getLatestJwks | pnpm exec convex env set JWKS",
        "generate:db-diagram": "d2 --layout=dagre --pad=20 --dagre-nodesep=30 --dagre-edgesep=10 figures/modelo-datos-er.d2 figures/modelo-datos-er-pdf.png",
        "generate:states-diagram": "d2 --layout=elk --pad=20 figures/estados-objetivo.d2 figures/estados-objetivo.png",
        "playwright:install": "pnpm exec playwright install",
        "playwright:install:ci": "pnpm exec playwright install --with-deps chromium firefox webkit",
        "doctor": "react-doctor --verbose --full"
    },
    "dependencies": {
        "@convex-dev/react-query": "^0.1.0",
        "@convex-dev/resend": "0.2.6",
        "@convex-dev/workflow": "0.4.4",
        "@convex-dev/workpool": "0.4.9",
        "@radix-ui/react-alert-dialog": "1.1.23",
        "@radix-ui/react-dialog": "1.1.23",
        "@radix-ui/react-dropdown-menu": "2.1.24",
        "@radix-ui/react-label": "2.1.15",
        "@radix-ui/react-popover": "1.1.23",
        "@radix-ui/react-progress": "1.1.16",
        "@radix-ui/react-radio-group": "1.4.7",
        "@radix-ui/react-select": "2.3.7",
        "@radix-ui/react-slot": "1.3.3",
        "@radix-ui/react-switch": "1.3.7",
        "@radix-ui/react-tabs": "1.1.21",
        "@radix-ui/react-tooltip": "1.2.16",
        "@tanstack/react-form": "1.33.3",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-table": "8.21.3",
        "better-auth": "1.6.23",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "1.43.0",
        "convex-helpers": "0.1.120",
        "hono": "4.13.1",
        "js-cookie": "3.0.8",
        "kitcn": "^0.15.14",
        "lucide-react": "1.30.0",
        "next": "16.2.12",
        "next-intl": "4.13.5",
        "next-themes": "0.4.6",
        "nodemailer": "9.0.5",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "recharts": "3.10.1",
        "server-only": "^0.0.1",
        "sonner": "2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "1.4.0",
        "ua-parser-js": "2.0.10",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@convex-dev/eslint-plugin": "^2.0.0",
        "@edge-runtime/vm": "^5.0.0",
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "16.2.12",
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@types/js-cookie": "3.0.6",
        "@types/node": "~24.13.3",
        "@types/nodemailer": "8.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitest/coverage-v8": "^4.1.10",
        "auth": "1.6.23",
        "babel-plugin-react-compiler": "^1.0.0",
        "convex-test": "0.0.55",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "knip": "^6.31.0",
        "prettier": "^3.9.6",
        "react-doctor": "^0.2.1",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.1",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "packageManager": "pnpm@11.20.0"
}
